# Application
APP_NAME=AudioKeep
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
API_VERSION=v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://audiokeep:audiokeep_password@postgres:5432/audiokeep
POSTGRES_USER=audiokeep
POSTGRES_PASSWORD=audiokeep_password
POSTGRES_DB=audiokeep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO/S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=audiokeep
S3_REGION=us-east-1
USE_S3=true

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@audiokeep.io
SMTP_FROM_NAME=AudioKeep

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_STARTER=price_starter_pack
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_pack
STRIPE_PRICE_ID_STUDIO=price_studio_pack
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_pack
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_ID_STUDIO_MONTHLY=price_studio_monthly
STRIPE_PRICE_ID_FORENSIC_MONTHLY=price_forensic_monthly

# AI Models Configuration
MODEL_CACHE_DIR=/app/models
TORCH_HOME=/app/torch_cache
HF_HOME=/app/hf_cache
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda  # or 'cpu' for development without GPU

# Processing Configuration
MAX_UPLOAD_SIZE_MB=2048
MAX_AUDIO_DURATION_SECONDS=28800  # 8 hours
DEFAULT_SAMPLE_RATE=48000
SUPPORTED_FORMATS=wav,mp3,flac,m4a,ogg,aac,wma
MAX_BATCH_SIZE=10
PROCESSING_TIMEOUT_SECONDS=3600  # 1 hour

# Credit System
FREE_TIER_CREDITS=50
CREDIT_PACK_STARTER=100
CREDIT_PACK_PROFESSIONAL=500
CREDIT_PACK_STUDIO=1500
CREDIT_PACK_ENTERPRISE=5000
MONTHLY_PRO_CREDITS=500
MONTHLY_STUDIO_CREDITS=1500
MONTHLY_FORENSIC_CREDITS=4000

# File Retention
FILE_RETENTION_DAYS=30
TEMP_FILE_CLEANUP_HOURS=24

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Feature Flags
ENABLE_FORENSIC_FEATURES=true
ENABLE_BATCH_PROCESSING=true
ENABLE_API_ACCESS=true
ENABLE_WEBHOOK_NOTIFICATIONS=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=100

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
POSTHOG_API_KEY=

# GPU Configuration
GPU_MEMORY_FRACTION=0.9
ENABLE_MIXED_PRECISION=true
BATCH_INFERENCE_SIZE=4
